# Скомпилированные исполняемые файлы Go.
*.exe
*.exe~
*.dll
*.so
*.dylib

# Результаты выполнения тестов, профилирования и измерения покрытия.
*.test
*.out
coverage/

# Каталоги со сборочными артефактами проекта.
bin/
build/
dist/

# Локальные файлы окружения могут содержать пароли, токены и адреса сервисов.
.env
.env.*
!.env.example

# Локальные настройки IDE и редакторов не являются частью проекта.
.idea/
.vscode/
*.swp
*.swo

# Системные файлы Windows и macOS.
Thumbs.db
.DS_Store

# Локальные данные контейнеров не должны попадать в Git.
.docker-data/
